# =============================================================================
# AI Service — Environment Variables
# =============================================================================
# Copy this to .env and fill in real values.

# --- Google Gemini ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Database ---
DATABASE_URL=postgresql://finai:finai_dev_password@localhost:5432/finai

# --- Redis ---
REDIS_URL=redis://localhost:6379
# How long (seconds) to keep conversation history per user (default: 30 min)
CONVERSATION_TTL_SECONDS=1800

# --- LangSmith (optional but strongly recommended) ---
# Free tier at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=finai-production

# --- Internal Security ---
# Must match INTERNAL_API_SECRET in Core API's .env
INTERNAL_API_SECRET=your_internal_secret_key_here

# --- Service Config ---
AI_SERVICE_PORT=8000
# Internal URL of the WhatsApp service (for WhatsApp tools)
WHATSAPP_INTERNAL_URL=http://localhost:3001

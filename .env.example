# =============================================================================
# FinAI — Environment Variables Reference
# =============================================================================
# Copy this file to .env in each service directory and fill in real values.
# NEVER commit actual .env files to git.
# =============================================================================

# =============================================================================
# CORE API (backend/)
# =============================================================================

# --- Database ---
# PostgreSQL connection string (Supabase / Neon / Railway / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/finai?schema=public"
# Direct connection URL (same as DATABASE_URL unless using connection pooling)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/finai?schema=public"

# --- Redis ---
# Redis connection string (Redis Cloud / Upstash / local)
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# JWT secret — generate with: openssl rand -hex 64
JWT_SECRET="your_super_secret_jwt_key_min_32_chars"

# --- Google OAuth ---
GOOGLE_ANDROID_CLIENT_ID="your_android_client_id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your_ios_client_id.apps.googleusercontent.com"
GOOGLE_WEB_CLIENT_ID="your_web_client_id.apps.googleusercontent.com"

# --- M-Pesa (Safaricom Daraja) ---
# Get from: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="your_mpesa_passkey"
# Public webhook URL for M-Pesa callbacks (use ngrok for local dev)
MPESA_CALLBACK_URL="https://your-domain.com/api/webhook/mpesa"

# --- Server ---
PORT=3000
NODE_ENV="development"
USE_CLUSTER="false"

# --- Internal Service URLs ---
# AI Service base URL (Python FastAPI)
AI_SERVICE_URL="http://localhost:8000"
# WhatsApp Service internal URL
WHATSAPP_INTERNAL_URL="http://localhost:3001"
WHATSAPP_INTERNAL_PORT=3001

# =============================================================================
# AI SERVICE (ai-service/)
# =============================================================================

# --- Google Gemini ---
# Get from: https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY="your_gemini_api_key"
# Model to use (gemini-2.0-flash recommended for speed + cost)
GEMINI_MODEL="gemini-2.0-flash"

# --- LangSmith Observability (optional but recommended) ---
# Get from: https://smith.langchain.com/ (free tier available)
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="your_langsmith_api_key"
LANGCHAIN_PROJECT="finai-production"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# --- AI Service Config ---
AI_SERVICE_PORT=8000
# Redis URL (same as above — shared)
REDIS_URL="redis://localhost:6379"
# Conversation history TTL in seconds (30 minutes default)
CONVERSATION_TTL_SECONDS=1800
# Internal secret to authenticate requests from Core API to AI Service
INTERNAL_API_SECRET="your_internal_secret_key_min_32_chars"

# --- Database (AI Service reads directly for tool calls) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/finai?schema=public"

# =============================================================================
# WHATSAPP SERVICE (chatbot/whatsapp-service.ts)
# =============================================================================

# Internal API port for outgoing WhatsApp messages
WHATSAPP_INTERNAL_PORT=3001

# =============================================================================
# NOTES
# =============================================================================
# 1. For local development, run: docker-compose up -d
#    This starts PostgreSQL + Redis with default credentials.
# 2. For M-Pesa local testing, use ngrok:
#    ngrok http 3000
#    Then set MPESA_CALLBACK_URL to the ngrok HTTPS URL.
# 3. LangSmith is optional — set LANGCHAIN_TRACING_V2="false" to disable.
# 4. INTERNAL_API_SECRET secures Core API → AI Service communication.
#    Generate with: openssl rand -hex 32

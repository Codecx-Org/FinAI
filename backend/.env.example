# M-Pesa API Credentials
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORT_CODE=your_mpesa_shortcode

# AI & LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
POLLINATIONS_API_KEY=your_pollinations_api_key

# Database Configuration
# Runtime: app queries (local Postgres, or Supabase transaction pooler on port 6543 in production)
DATABASE_URL=postgresql://user:password@localhost:5432/bizsawaDB
# Migrations only: direct Postgres (local: same as DATABASE_URL; Supabase: db.<ref>.supabase.co:5432)
DIRECT_URL=postgresql://user:password@localhost:5432/bizsawaDB

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key

# Infrastructure
REDIS_URL=redis://localhost:6379
PORT=3000

# Cloudflare Configuration
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# =============================================================================
# FinAI Core API — Environment Variables
# =============================================================================
# Copy this to .env and fill in real values.
# See root .env.example for full documentation of all keys.

# --- Database (Prisma) ---
DATABASE_URL="postgresql://finai:finai_dev_password@localhost:5432/finai?schema=public"
DIRECT_URL="postgresql://finai:finai_dev_password@localhost:5432/finai?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change_this_to_a_64_char_hex_string"

# --- Google OAuth (optional) ---
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_WEB_CLIENT_ID=""

# --- M-Pesa (Safaricom Daraja) ---
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
# Use ngrok for local testing: ngrok http 3000
MPESA_CALLBACK_URL="https://your-domain.com/api/webhook/mpesa"

# --- Internal Services ---
# URL of the Python AI service
AI_SERVICE_URL="http://localhost:8000"
# Must match INTERNAL_API_SECRET in ai-service/.env
INTERNAL_API_SECRET=""

# --- Server ---
PORT=3000
NODE_ENV="development"
USE_CLUSTER="false"
